# Copie para .env (NÃO versionar) e preencha. Gere segredos com:  openssl rand -base64 48

# Domínio apontado (registro A) para o IP do servidor — o HTTPS é emitido automaticamente.
DOMAIN=crm.suaempresa.com.br

# Banco de dados
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Assinatura das sessões (48+ caracteres aleatórios)
JWT_SIGNING_KEY=

# Primeiro acesso: cria a organização e o administrador quando o banco está vazio.
BOOTSTRAP_ORG_NAME=Minha Loteadora
BOOTSTRAP_ORG_SLUG=principal
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# Mínimo de 12 caracteres. Troque após o primeiro login (e remova daqui).
BOOTSTRAP_ADMIN_PASSWORD=

# Servidor de DEMONSTRAÇÃO: true cria as organizações fictícias "demo" e "outra".
SEED_DEMO_DATA=false
SEED_PASSWORD=
